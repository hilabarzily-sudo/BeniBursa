# ============================================
# REQUIRED - Phase 1 (MVP)
# ============================================

# Anthropic - get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase - create project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Python worker URL (local dev)
WORKER_URL=http://localhost:8787
WORKER_SECRET=dev-shared-secret-change-me

# Inngest (local dev works without cloud account)
INNGEST_EVENT_KEY=local-dev
INNGEST_SIGNING_KEY=local-dev

# ============================================
# OPTIONAL - Phase 2 (scale)
# ============================================

# Cloudflare R2 (optional - Supabase Storage works for MVP)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=benibursa-media

# Modal / RunPod for GPU workers (optional)
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Twelve Labs for advanced video understanding (optional, expensive)
# TWELVELABS_API_KEY=

# Music generation (optional)
# SUNO_API_KEY=
# MUBERT_API_KEY=

# Stripe billing (optional, for production)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
