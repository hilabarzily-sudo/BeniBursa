{
  "name": "benibursa",
  "version": "0.1.0",
  "private": true,
  "description": "Social Content Engine - autonomous multi-platform content generation from raw media",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "worker:dev": "cd apps/worker-py && uvicorn app.main:app --reload --port 8787",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
